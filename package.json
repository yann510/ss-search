{
  "name": "@ss-search/source",
  "version": "1.8.1",
  "description": "The most basic, yet powerful text search.",
  "keywords": [
    "search",
    "typescript",
    "simple",
    "fast",
    "text",
    "full-text",
    "browser",
    "node",
    "indexed",
    "JavaScript",
    "array",
    "object",
    "easy"
  ],
  "homepage": "https://github.com/yann510/ss-search",
  "bugs": {
    "url": "https://github.com/yann510/ss-search/issues"
  },
  "author": {
    "name": "Yann Thibodeau",
    "email": "y.thibodeau1@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yann510/ss-search"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ci:local": "npm run format:write && nx run-many --targets=lint --fix && nx run-many --targets=build,test",
    "format:check:ci": "nx format:check --base=origin/master",
    "format:check:local": "nx format:check --base=origin/master",
    "format:write": "nx format:write --base=origin/master",
    "lint:all": "nx run-many --target=lint --all",
    "test:all": "nx run-many --target=test --all",
    "build:all": "nx run-many --target=build --all",
    "exports:check": "attw --pack dist/ss-search/.",
    "pre-run:ci:local": "npm run format:write && nx run-many --targets=lint --fix && nx run-many --targets=build,test",
    "benchmark": "nx run benchmark:build && node dist/benchmark/main.js",
    "web-app:serve": "nx run web-app:serve",
    "netlify:deploy": "nx run web-app:build --prod && netlify deploy --prod --no-build --dir=dist/web-app"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "@swc/helpers": "0.5.23",
    "axios": "1.19.0",
    "clsx": "2.1.1",
    "flexsearch": "0.8.212",
    "fuse.js": "7.5.0",
    "fuzzysort": "4.0.2",
    "js-search": "2.0.1",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "lunr": "2.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-highlight-words": "0.21.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "tslib": "2.8.1",
    "tss-react": "4.9.21"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@nx/esbuild": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/rspack": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "2.2.0",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@testing-library/react": "16.3.2",
    "@types/benchmark": "2.1.5",
    "@types/jest": "30.0.0",
    "@types/js-search": "1.4.4",
    "@types/lodash": "4.17.25",
    "@types/lodash-es": "4.17.12",
    "@types/lunr": "2.3.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-highlight-words": "0.20.1",
    "babel-jest": "30.4.1",
    "benchmark": "2.1.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "30.4.1",
    "jsonc-eslint-parser": "3.3.0",
    "netlify-cli": "27.1.2",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "react-refresh": "0.18.0",
    "ts-jest": "29.4.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.1",
    "esbuild": "$esbuild",
    "nx": {
      "brace-expansion": "5.0.9"
    },
    "sharp": "0.35.3"
  },
  "nxrelease": {
    "repositoryUrl": "https://github.com/yann510/ss-search",
    "tagFormat": "v${version}",
    "buildTarget": "ss-search:build",
    "outputPath": "dist/ss-search",
    "gitAssets": [
      "CHANGELOG.md",
      "package.json",
      "package-lock.json",
      "ss-search/package.json",
      "ss-search/package-lock.json",
      "web-app/src/assets/benchmarkResults.json"
    ]
  }
}
